rules_version = '2';

// Single-user app: client-side rules require authentication; the server-side
// allowlist (ALLOWED_EMAIL in Cloud Functions) is the real gate. Rules deny
// any client write that doesn't carry the owner's email so a stolen token
// can't be used to scribble into someone else's docs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function ownsExisting() {
      return resource != null && resource.data.ownerEmail == request.auth.token.email;
    }

    function ownsIncoming() {
      return request.resource.data.ownerEmail == request.auth.token.email;
    }

    // PCO credentials are admin-SDK-only. The savePcoCredentials Cloud
    // Function writes here; other Cloud Functions read here to act on
    // behalf of the user. Clients never see these values directly.
    match /pcoCredentials/{uid} {
      allow read, write: if false;
    }

    // Per-user prompt config (default structure prompt + per-plan overrides).
    // Read/write through Cloud Functions only, like pcoCredentials, so the
    // SPA goes through the typed savePromptConfig callable rather than
    // touching Firestore directly.
    match /userPrompts/{uid} {
      allow read, write: if false;
    }

    // System-wide prompt defaults, owned by admins. Admin Cloud Functions
    // are gated by ADMIN_EMAILS server-side; clients have no direct access.
    match /appConfig/{doc} {
      allow read, write: if false;
    }

    // Per-user picker session state per plan (candidate pool, decisions,
    // future conversation history). Read/write through callables only.
    match /pickerSessions/{uid}/plans/{planId} {
      allow read, write: if false;
    }

    // Per-user-per-plan map of song-slot itemId → empty-slot
    // placeholder title observed in PCO. Reconciled server-side on
    // every plan load (syncSlotPlaceholders) so a future clear can
    // restore the original slot name even when the slot was filled
    // before songpicker first observed it.
    match /slotPlaceholders/{uid}/plans/{planId} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow read: if signedIn() && ownsExisting();
      allow create: if signedIn() && ownsIncoming();
      allow update, delete: if signedIn() && ownsExisting() && ownsIncoming();
    }

    match /prompt_presets/{presetId} {
      allow read: if signedIn() && ownsExisting();
      allow create: if signedIn() && ownsIncoming();
      allow update, delete: if signedIn() && ownsExisting() && ownsIncoming();
    }

    match /sessions/{sessionId}/ai_turns/{turnId} {
      allow read, write: if signedIn() &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerEmail
          == request.auth.token.email;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
