# Copy to .env.local and fill in values from Firebase Console >
# Project Settings > Your apps > Web app > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region (default: us-central1)
VITE_FIREBASE_REGION=us-central1

# Restrict the SPA to a single Google account (your email).
# Server-side enforcement happens in Cloud Functions via ALLOWED_EMAIL param.
VITE_ALLOWED_EMAIL=

# Optional: your name as it appears in PCO worshipLeaders. Only needed
# if your Google account displayName doesn't match PCO exactly.
# Example: VITE_LEADER_NAME=Matt Trent
VITE_LEADER_NAME=

# Set to "true" to talk to local Firebase emulators instead of prod.
VITE_USE_EMULATORS=false

# ------------------------------------------------------------------
# Cloud Functions secrets and params (NOT loaded from this file).
# Set with the Firebase CLI:
#
#   firebase functions:secrets:set PCO_APP_ID
#   firebase functions:secrets:set PCO_SECRET
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set OPENAI_API_KEY
#
#   echo "ALLOWED_EMAIL=you@example.com\nAI_PROVIDER=anthropic" > functions/.env
# ------------------------------------------------------------------
