# Copy to functions/.secret.local and fill in. The Firebase Functions
# emulator reads this file in place of Google Secret Manager when running
# locally. .gitignored — never committed.
#
# Tip: pull the values from your deployed secrets:
#   firebase functions:secrets:access PCO_APP_ID
#   firebase functions:secrets:access PCO_SECRET
#   firebase functions:secrets:access GEMINI_API_KEY
PCO_APP_ID=
PCO_SECRET=
GEMINI_API_KEY=
