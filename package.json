{
  "name": "songpicker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only functions,firestore --import=.emulator-data --export-on-exit=.emulator-data \"concurrently -n vite,fns -c cyan,magenta npm:dev:vite npm:dev:functions\"",
    "dev:vite": "vite",
    "dev:emulators": "firebase emulators:start --only functions,firestore --import=.emulator-data --export-on-exit=.emulator-data",
    "dev:functions": "npm --prefix functions run build:watch",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run lint && npm test && npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.9"
  }
}
