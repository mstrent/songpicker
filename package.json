{
  "name": "songpicker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only functions,firestore --import=.emulator-data --export-on-exit=.emulator-data \"concurrently -n vite,fns -c cyan,magenta npm:dev:vite npm:dev:functions\"",
    "dev:vite": "vite",
    "dev:emulators": "firebase emulators:start --only functions,firestore --import=.emulator-data --export-on-exit=.emulator-data",
    "dev:functions": "npm --prefix functions run build:watch",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run lint && npm test && npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
